# Copy this file to ".env" and fill in your own values. NEVER commit ".env".

# MongoDB Atlas connection string (Atlas > Connect > Drivers). URL-encode special characters in the password.
MONGODB_URI=mongodb+srv://sushmitha:<db_password>@cluster0.d2bmuox.mongodb.net/
MONGODB_DB=loan_intel_desk
MONGODB_COLLECTION=predictions

# Where the Streamlit frontend finds the FastAPI backend
API_BASE_URL=http://127.0.0.1:8000

# Allowed browser origins for the API (comma-separated). Add your deployed frontend URL for production.
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Optional override (defaults to model/loan_model.pkl)
# MODEL_PATH=model/loan_model.pkl
